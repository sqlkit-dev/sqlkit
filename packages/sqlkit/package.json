{
  "name": "sqlkit",
  "version": "2.0.0",
  "description": "TypeScript query builder and repository layer for PostgreSQL",
  "license": "MIT",
  "author": {
    "name": "KingRayhan",
    "url": "https://www.rayhan.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sqlkit-dev/sqlkit"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll --sourcemap --clean-dist --minify",
    "prepublishOnly": "bun run build",
    "tinker": "bun --watch src/tinker.ts",
    "test": "jest --testPathPattern=repository --runInBand",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "npx typedoc src/index.ts --readme README.md --out ../../docs"
  },
  "keywords": [
    "sql",
    "postgresql",
    "postgres",
    "query builder",
    "orm",
    "database",
    "typescript"
  ],
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "pg": "^8.14.1",
    "pkgroll": "^2.12.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2"
  },
  "peerDependencies": {
    "pg": "^8.16.0",
    "@types/pg": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
